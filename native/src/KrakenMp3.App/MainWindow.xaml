<Window x:Class="KrakenMp3.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="Kraken MP3" Width="440" SizeToContent="Height"
        WindowStyle="None" ResizeMode="CanMinimize" AllowDrop="True"
        Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BevelLight}" BorderThickness="1"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Window.ContextMenu>
        <ContextMenu x:Name="MainMenu" Opened="MainMenu_Opened">
            <MenuItem Header="Open files…" InputGestureText="Ctrl+O" Click="Open_Click"/>
            <MenuItem Header="Add folder…" InputGestureText="Ctrl+Shift+O" Click="AddFolder_Click"/>
            <Separator/>
            <MenuItem x:Name="PlaylistItem" Header="Playlist" InputGestureText="P" IsCheckable="True" Click="PlToggle_Click"/>
            <MenuItem x:Name="EqMenu" Header="Equalizer">
                <MenuItem x:Name="EqWindowItem" Header="Show window" InputGestureText="E" IsCheckable="True" Click="EqToggle_Click"/>
                <MenuItem x:Name="EqEnabledItem" Header="Enabled" IsCheckable="True" Click="EqEnabled_Click"/>
                <Separator/>
            </MenuItem>
            <MenuItem Header="Visualizer">
                <MenuItem x:Name="VizShowItem" Header="Show" InputGestureText="V" IsCheckable="True" Click="VizShow_Click"/>
                <MenuItem x:Name="VizModeMenu" Header="Mode"/>
                <MenuItem x:Name="VizArtMenu" Header="Album art"/>
                <MenuItem x:Name="VizBgMenu" Header="Background"/>
                <MenuItem x:Name="VizFpsMenu" Header="Frame rate"/>
            </MenuItem>
            <MenuItem x:Name="FxItem" Header="Effects &amp; themes" InputGestureText="~" IsCheckable="True" Click="FxToggle_Click"/>
            <MenuItem x:Name="OnTopItem" Header="Always on top" IsCheckable="True" Click="OnTop_Click"/>
            <Separator/>
            <MenuItem Header="Exit" Click="Close_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <StackPanel>
        <!-- Title bar -->
        <Grid x:Name="TitleBar" Height="18" Background="{DynamicResource TitleBg}" MouseLeftButtonDown="TitleBar_MouseDown">
            <TextBlock Text="✦ KRAKEN MP3 ✦" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMid}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0">
                <Button x:Name="EqToggle" Style="{StaticResource TitleButton}" Content="EQ" ToolTip="Equalizer (E)" Click="EqToggle_Click"/>
                <Button x:Name="PlToggle" Style="{StaticResource TitleButton}" Content="PL" ToolTip="Playlist (P)" Click="PlToggle_Click"/>
                <Button x:Name="VizToggle" Style="{StaticResource TitleButton}" Content="VIZ" ToolTip="Visualizer (V)" Click="VizShow_Click"/>
                <Button x:Name="OnTopButton" Style="{StaticResource TitleButton}" Content="▲" ToolTip="Always on top" Click="OnTop_Click"/>
                <Button Style="{StaticResource TitleButton}" Content="─" ToolTip="Minimize" Click="Minimize_Click"/>
                <Button Style="{StaticResource TitleButton}" Content="×" ToolTip="Close" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <!-- LCD -->
        <Border Background="{DynamicResource LcdBg}" BorderBrush="{DynamicResource BevelDark}" BorderThickness="0,1">
            <Grid Margin="8,6" MinHeight="58">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="124"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <Border BorderBrush="{DynamicResource BevelDark}" BorderThickness="1" Background="#020A0E" Width="74" Height="16">
                        <skia:SKElement x:Name="MiniViz" Width="72" Height="14"/>
                    </Border>
                    <TextBlock x:Name="ClockText" Text="0:00" FontFamily="{StaticResource LcdFont}" FontSize="26" FontWeight="Black"
                               Foreground="{DynamicResource Lcd}" HorizontalAlignment="Center" Margin="0,2,0,0"
                               Cursor="Hand" ToolTip="Toggle remaining time" MouseLeftButtonDown="Clock_MouseDown">
                        <TextBlock.Effect>
                            <DropShadowEffect x:Name="ClockGlow" Color="#3CE0F8" BlurRadius="12" ShadowDepth="0" Opacity="0.55"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="6,0" VerticalAlignment="Center">
                    <Canvas x:Name="TickerHost" Height="16" ClipToBounds="True" SizeChanged="TickerHost_SizeChanged">
                        <TextBlock x:Name="TickerText" FontFamily="{StaticResource LcdFont}" FontSize="12"
                                   Foreground="{DynamicResource Lcd}" Text="Kraken MP3 · drop music here"/>
                    </Canvas>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock x:Name="BitrateText" Text="---" FontFamily="{StaticResource LcdFont}" FontSize="11" Foreground="{DynamicResource Lcd}"/>
                        <TextBlock Text="kbps" FontSize="8" Foreground="{DynamicResource LcdDim}" Margin="2,2,8,0"/>
                        <TextBlock x:Name="RateText" Text="--" FontFamily="{StaticResource LcdFont}" FontSize="11" Foreground="{DynamicResource Lcd}"/>
                        <TextBlock Text="kHz" FontSize="8" Foreground="{DynamicResource LcdDim}" Margin="2,2,8,0"/>
                        <TextBlock x:Name="MonoText" Text="mono" FontSize="9" Foreground="{DynamicResource LcdDim}" Margin="0,1,4,0"/>
                        <TextBlock x:Name="StereoText" Text="stereo" FontSize="9" Foreground="{DynamicResource LcdDim}" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="VOL" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextMid}" Width="22" VerticalAlignment="Center"/>
                        <TextBlock x:Name="VolText" DockPanel.Dock="Right" Text="80%" FontSize="9" Width="30" TextAlignment="Right"
                                   Foreground="{DynamicResource Lcd}" VerticalAlignment="Center"/>
                        <Slider x:Name="VolumeSlider" Style="{StaticResource LcdSlider}" Minimum="0" Maximum="100" Value="80"
                                ToolTip="Volume (Up/Down, M to mute)"/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="BAL" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextMid}" Width="22" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BalText" DockPanel.Dock="Right" Text="C" FontSize="9" Width="30" TextAlignment="Right"
                                   Foreground="{DynamicResource Lcd}" VerticalAlignment="Center"/>
                        <Slider x:Name="BalanceSlider" Style="{StaticResource LcdSlider}" Minimum="-100" Maximum="100" Value="0"
                                ToolTip="Balance (double-click to centre)"/>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Progress -->
        <Slider x:Name="SeekSlider" Style="{StaticResource LcdSlider}" Margin="6,4,6,2" Minimum="0" Maximum="1"/>

        <!-- Transport -->
        <DockPanel Margin="5,1,5,5">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button ToolTip="Previous (Ctrl+←)" Click="Prev_Click" Width="30"><Path Data="M0,0 H2 V10 H0 Z M10,0 V10 L2.5,5 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="Uniform"/></Button>
                <Button x:Name="PlayButton" ToolTip="Play/Pause (Space)" Click="Play_Click" Width="34">
                    <Grid>
                        <Path x:Name="PlayIcon" Data="M0,0 L9,5 L0,10 Z" Width="9" Height="10" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <Path x:Name="PauseIcon" Data="M0,0 H3 V10 H0 Z M6,0 H9 V10 H6 Z" Width="9" Height="10" Stretch="Uniform" Visibility="Collapsed"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Grid>
                </Button>
                <Button ToolTip="Stop" Click="Stop_Click" Width="30"><Path Data="M0,0 H9 V9 H0 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="9" Height="10" Stretch="Uniform"/></Button>
                <Button ToolTip="Next (Ctrl+→)" Click="Next_Click" Width="30"><Path Data="M0,0 L7.5,5 L0,10 Z M8,0 H10 V10 H8 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="Uniform"/></Button>
                <Button ToolTip="Open files (Ctrl+O)" Click="Open_Click" Width="30"><Path Data="M5,0 L10,6 H0 Z M0,7.5 H10 V10 H0 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="Uniform"/></Button>
            </StackPanel>
            <Button x:Name="FxButton" DockPanel.Dock="Right" Content="FX" ToolTip="Effects, visualizers and themes (~)" Click="FxToggle_Click" MinWidth="30"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="ShuffleButton" Content="SHUFFLE" ToolTip="Shuffle (S)" Click="Shuffle_Click"/>
                <Button x:Name="RepeatButton" Content="REPEAT" ToolTip="Repeat (R)" Click="Repeat_Click" MinWidth="58"/>
            </StackPanel>
        </DockPanel>

    </StackPanel>
</Window>
